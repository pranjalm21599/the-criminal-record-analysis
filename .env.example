# Copy to .env at the repo root:  cp .env.example .env
# docker-compose reads GEMINI_API_KEY from here; the rest are for running
# services directly on the host without Docker.

# --- Databases ---
DATABASE_URL=postgresql://admin:password@localhost:5432/criminal_db
MONGO_URL=mongodb://localhost:27017/criminal_docs
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=criminal123

# --- Service URLs ---
BACKEND_API=http://localhost:8000
NLP_API=http://localhost:8001
GRAPH_API=http://localhost:8002
ANALYSIS_API=http://localhost:8003
AI_API=http://localhost:8004

# --- AI ---
# Free key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
